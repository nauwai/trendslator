{
    "name": "Trendslator",
    "short_name": "Trendslator",
    "description": "Tendances et langage du web francophone",
    "start_url": "/onboarding.html",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "browser"],
    "orientation": "portrait-primary",
    "lang": "fr",
    "dir": "ltr",
    "theme_color": "#fe502d",
    "background_color": "#ffffff",
    "icons": [
        {
            "src": "android-chrome-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "android-chrome-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
